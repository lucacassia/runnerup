<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. Dark color roles (override values/themes.xml). -->
    <style name="AppTheme" parent="Theme.Material3.DayNight">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Material3</item>

        <item name="colorPrimary">#FAB283</item>
        <item name="colorOnPrimary">#0A0A0A</item>
        <item name="colorPrimaryContainer">#1E1E1E</item>
        <item name="colorOnPrimaryContainer">#EEEEEE</item>
        <item name="colorPrimaryInverse">#3B7DD8</item>
        <item name="colorSecondary">#5C9CF5</item>
        <item name="colorOnSecondary">#0A0A0A</item>
        <item name="colorSecondaryContainer">#1E1E1E</item>
        <item name="colorOnSecondaryContainer">#EEEEEE</item>
        <item name="colorTertiary">#9D7CD8</item>
        <item name="colorOnTertiary">#0A0A0A</item>
        <item name="colorTertiaryContainer">#1E1E1E</item>
        <item name="colorOnTertiaryContainer">#EEEEEE</item>
        <item name="colorError">#E06C75</item>
        <item name="colorOnError">#1A1A1A</item>
        <item name="colorErrorContainer">#282828</item>
        <item name="colorOnErrorContainer">#EEEEEE</item>
        <item name="colorSurface">#0A0A0A</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="colorOnSurface">#EEEEEE</item>
        <item name="colorSurfaceVariant">#141414</item>
        <item name="colorOnSurfaceVariant">#808080</item>
        <item name="colorSurfaceContainerLowest">#0A0A0A</item>
        <item name="colorSurfaceContainerLow">#141414</item>
        <item name="colorSurfaceContainer">#1E1E1E</item>
        <item name="colorSurfaceContainerHigh">#282828</item>
        <item name="colorSurfaceContainerHighest">#323232</item>
        <item name="colorSurfaceBright">#3C3C3C</item>
        <item name="colorSurfaceDim">#0A0A0A</item>
        <item name="colorOutline">#484848</item>
        <item name="colorOutlineVariant">#3C3C3C</item>
        <item name="colorSurfaceInverse">#FFFFFF</item>
        <item name="colorOnSurfaceInverse">#1A1A1A</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="@style/AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="MainLayoutTheme" parent="AppTheme.NoActionBar">
    </style>

</resources>
