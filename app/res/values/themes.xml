<resources>

    <!-- Base application theme. Follows the system light/dark setting. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Material3</item>

        <item name="colorPrimary">#3B7DD8</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#F5F5F5</item>
        <item name="colorOnPrimaryContainer">#1A1A1A</item>
        <item name="colorPrimaryInverse">#FAB283</item>
        <item name="colorSecondary">#7B5BB6</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#F5F5F5</item>
        <item name="colorOnSecondaryContainer">#1A1A1A</item>
        <item name="colorTertiary">#D68C27</item>
        <item name="colorOnTertiary">#1A1A1A</item>
        <item name="colorTertiaryContainer">#F5F5F5</item>
        <item name="colorOnTertiaryContainer">#1A1A1A</item>
        <item name="colorError">#D1383D</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">#EBEBEB</item>
        <item name="colorOnErrorContainer">#1A1A1A</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="colorOnSurface">#1A1A1A</item>
        <item name="colorSurfaceVariant">#FAFAFA</item>
        <item name="colorOnSurfaceVariant">#595959</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#FAFAFA</item>
        <item name="colorSurfaceContainer">#F5F5F5</item>
        <item name="colorSurfaceContainerHigh">#EBEBEB</item>
        <item name="colorSurfaceContainerHighest">#E1E1E1</item>
        <item name="colorSurfaceBright">#FFFFFF</item>
        <item name="colorSurfaceDim">#EBEBEB</item>
        <item name="colorOutline">#B8B8B8</item>
        <item name="colorOutlineVariant">#D4D4D4</item>
        <item name="colorSurfaceInverse">#0A0A0A</item>
        <item name="colorOnSurfaceInverse">#EEEEEE</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="@style/AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="MainLayoutTheme" parent="AppTheme.NoActionBar">
    </style>

</resources>
