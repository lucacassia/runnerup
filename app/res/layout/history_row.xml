<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/history_card"
    style="?attr/materialCardViewFilledStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/history_row_margin_h"
    android:layout_marginTop="@dimen/history_row_margin_v"
    android:layout_marginEnd="@dimen/history_row_margin_h"
    android:layout_marginBottom="@dimen/history_row_margin_v"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/history_row_corner"
    app:cardElevation="0dp"
    app:rippleColor="?attr/colorControlHighlight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/history_list_emblem"
            android:layout_width="@dimen/history_avatar_size"
            android:layout_height="@dimen/history_avatar_size"
            android:background="@drawable/sport_avatar_bg"
            android:contentDescription="@string/Sport"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/ListItem"
                android:id="@+id/history_list_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_history_distance"
                android:drawablePadding="6dp"
                app:drawableEndCompat="@drawable/ic_chevron_right_24dp"
                android:gravity="center_vertical"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold" />

            <TextView
                style="@style/ListDescription"
                android:id="@+id/history_list_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawableStart="@drawable/ic_history_date"
                android:drawablePadding="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/ListDescription"
                    android:id="@+id/history_list_duration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:drawableStart="@drawable/ic_history_duration"
                    android:drawablePadding="4dp" />

                <TextView
                    style="@style/ListDescription"
                    android:id="@+id/history_list_pace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:layout_marginStart="8dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:drawableStart="@drawable/ic_history_pace"
                    android:drawablePadding="4dp" />

                <TextView
                    style="@style/ListDescription"
                    android:id="@+id/history_list_additional"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:layout_marginStart="8dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:drawablePadding="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
